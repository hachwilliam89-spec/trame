{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2024", "esnext.temporal", "dom"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@trame/api/database": ["./libs/api/shared/database/src/index.ts"],
      "@trame/api/database/testing": ["./libs/api/shared/database/src/testing.ts"],
      "@trame/api/organization/application": ["./libs/api/organization/application/src/index.ts"],
      "@trame/api/organization/application/testing": [
        "./libs/api/organization/application/src/testing.ts"
      ],
      "@trame/api/organization/domain": ["./libs/api/organization/domain/src/index.ts"],
      "@trame/api/organization/infrastructure": [
        "./libs/api/organization/infrastructure/src/index.ts"
      ],
      "@trame/platform/auth": ["./libs/platform/auth/src/index.ts"],
      "@trame/platform/auth/testing": ["./libs/platform/auth/src/testing.ts"],
      "@trame/platform/clock": ["./libs/platform/clock/src/index.ts"],
      "@trame/platform/config": ["./libs/platform/config/src/index.ts"],
      "@trame/platform/health": ["./libs/platform/health/src/index.ts"],
      "@trame/platform/ids": ["./libs/platform/ids/src/index.ts"],
      "@trame/platform/logging": ["./libs/platform/logging/src/index.ts"],
      "@trame/platform/pagination": ["./libs/platform/pagination/src/index.ts"],
      "@trame/platform/problem-details": ["./libs/platform/problem-details/src/index.ts"],
      "@trame/platform/zod-validation": ["./libs/platform/zod-validation/src/index.ts"],
      "@trame/shared/contracts": ["./libs/shared/contracts/src/index.ts"],
      "@trame/api/scheduling/domain": ["./libs/api/scheduling/domain/src/index.ts"],
      "@trame/api/scheduling/application": ["./libs/api/scheduling/application/src/index.ts"],
      "@trame/api/scheduling/infrastructure": ["./libs/api/scheduling/infrastructure/src/index.ts"],
      "@trame/platform/idempotency": ["./libs/platform/idempotency/src/index.ts"],
      "@trame/platform/outbox": ["./libs/platform/outbox/src/index.ts"],
      "@trame/api/scheduling/application/testing": [
        "./libs/api/scheduling/application/src/testing.ts"
      ],
      "@trame/platform/messaging": ["./libs/platform/messaging/src/index.ts"],
      "@trame/platform/inbox": ["./libs/platform/inbox/src/index.ts"],
      "@trame/platform/messaging/testing": ["./libs/platform/messaging/src/testing.ts"],
      "@trame/web/auth/data-access": ["./libs/web/auth/data-access/src/index.ts"],
      "@trame/web/scheduling/data-access": ["./libs/web/scheduling/data-access/src/index.ts"],
      "@trame/web/scheduling/feature-diagnostic": [
        "./libs/web/scheduling/feature-diagnostic/src/index.ts"
      ],
      "@trame/shared/contracts/scheduling": ["./libs/shared/contracts/src/scheduling/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
