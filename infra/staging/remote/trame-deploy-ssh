#!/usr/bin/env bash
# Commande imposée de la clé de déploiement de GitHub (ADR-0035), posée dans authorized_keys par
# `restrict,command="/usr/local/sbin/trame-deploy-ssh"`. Elle tourne sous l'utilisateur
# trame-deploy, sans shell : seules « deploy <commit complet> » et « rollback » passent, et sudo
# ne lui permet que /usr/local/sbin/trame-deploy, qui vérifie de nouveau sa demande.
set -euo pipefail

readonly ROOT_SCRIPT='/usr/local/sbin/trame-deploy'
readonly request="${SSH_ORIGINAL_COMMAND:-}"

refuse() {
  echo "Commande refusée : seules « deploy <commit complet> » et « rollback » sont acceptées." >&2
  exit 64
}

if [[ "$request" =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
  exec sudo -n "$ROOT_SCRIPT" deploy "${BASH_REMATCH[1]}"
fi
if [ "$request" = 'rollback' ]; then
  exec sudo -n "$ROOT_SCRIPT" rollback
fi
refuse
