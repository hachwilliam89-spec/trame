{
  "name": "infra",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "infra/src",
  "projectType": "library",
  "tags": ["scope:tooling"],
  "targets": {
    "up": {
      "description": "D\u00e9marre PostgreSQL, RabbitMQ et Keycloak, attend leur \u00e9tat sain, puis applique les migrations.",
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "docker compose --env-file .env -f infra/compose/dev.yml up --detach --wait --wait-timeout 120",
          "pnpm nx run api-database:migrate-deploy"
        ],
        "parallel": false
      },
      "cache": false
    },
    "down": {
      "description": "Arr\u00eate la stack. Garde les volumes PostgreSQL et RabbitMQ ; Keycloak est r\u00e9initialis\u00e9 \u00e0 la recr\u00e9ation.",
      "command": "docker compose --env-file .env -f infra/compose/dev.yml down",
      "cache": false
    },
    "reset": {
      "description": "Supprime aussi les volumes : les donn\u00e9es sont perdues. Relancer ensuite infra:up.",
      "command": "docker compose --env-file .env -f infra/compose/dev.yml down --volumes",
      "cache": false
    },
    "integration": {
      "description": "D\u00e9marre r\u00e9ellement la stack, sur des ports et un nom de projet d\u00e9di\u00e9s.",
      "dependsOn": ["api:build", "api-database:prisma-generate", "web:build"],
      "command": "vitest run --config vitest.integration.config.mts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
