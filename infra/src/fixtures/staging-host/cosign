#!/usr/bin/env bash
# Faux cosign du banc de déploiement : accepte toute signature, sauf celles des références que le
# test a listées dans $FAKE_STATE/refused-signatures.
set -eu
{
  printf '%s\t' "$(basename "$0")" "$@"
  printf '\n'
} >>"$FAKE_STATE/calls"
reference="${!#}"
if [ -f "$FAKE_STATE/refused-signatures" ] && grep -qxF "$reference" "$FAKE_STATE/refused-signatures"; then
  echo 'Error: no matching signatures' >&2
  exit 1
fi
echo '[]'
