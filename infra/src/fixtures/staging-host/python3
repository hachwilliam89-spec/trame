#!/usr/bin/env bash
# Faux python3 du banc de déploiement. Seule la lecture de l'horloge monotone de deploy.sh est
# simulée, pour compter le temps des contrôles externes sans l'attendre ; tout autre appel
# (vérificateur, verrou) va au vrai python3, que le banc désigne dans $FAKE_REAL_PYTHON3.
if [ "$#" -eq 3 ] && [ "$1" = '-I' ] && [ "$2" = '-c' ] && [[ "$3" == *CLOCK_MONOTONIC* ]]; then
  cat "$FAKE_STATE/clock"
  exit 0
fi
exec "$FAKE_REAL_PYTHON3" "$@"
