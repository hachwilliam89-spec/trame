{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/docs/src",
  "tags": ["scope:docs", "type:app"],
  "targets": {
    "build": {
      "command": "astro build --root apps/docs",
      "inputs": ["{projectRoot}/**/*", "!{projectRoot}/.astro/**/*"],
      "outputs": ["{workspaceRoot}/dist/apps/docs"],
      "cache": true
    },
    "serve": {
      "continuous": true,
      "command": "astro dev --root apps/docs"
    },
    "typecheck": {
      "command": "astro sync --root apps/docs && tsc --noEmit -p apps/docs/tsconfig.json",
      "cache": true
    }
  }
}
