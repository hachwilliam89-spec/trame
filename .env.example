# Copier en `.env` pour le développement local. Ne jamais commiter `.env`.

# API (apps/api)
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://trame:trame@localhost:5432/trame

# Moteur (apps/engine)
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8000
ENGINE_LOG_LEVEL=info
ENGINE_LOG_JSON=false
ENGINE_MAX_WORKERS=4
