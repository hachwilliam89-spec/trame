# Variables de développement local. Copier en `.env` à la racine : `cp .env.example .env`.
# Ne jamais commiter `.env`.
#
# Nx charge ce fichier pour toute commande `pnpm nx …` (serve, test, build…).
# Les applications ne lisent elles-mêmes aucun fichier `.env` : hors de Nx
# (`node dist/apps/api/main.js`, `uv run …`), exporter les variables, par exemple
# avec `set -a; . ./.env; set +a`. En staging et en prod, Docker Compose fournit
# l'environnement (US-005). Les tests n'en dépendent pas : chacun fixe ses valeurs.

# API (apps/api)
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://trame:trame@localhost:5432/trame
# Fournisseur d'identité : le Keycloak de la stack de dev (US-020).
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/trame
OIDC_AUDIENCE=trame-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/trame/protocol/openid-connect/certs

# Stack de dev (infra/compose/dev.yml) : `pnpm nx run infra:up`.
# DATABASE_URL ci-dessus reprend le compte, la base et le port de PostgreSQL.
POSTGRES_USER=trame
POSTGRES_PASSWORD=trame
POSTGRES_DB=trame
POSTGRES_PORT=5432
RABBITMQ_USER=trame
RABBITMQ_PASSWORD=trame
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
KEYCLOAK_PORT=8080
KEYCLOAK_DEV_REDIRECT_URI=http://127.0.0.1:4200/oidc-callback
KEYCLOAK_DEV_WEB_ORIGIN=http://127.0.0.1:4200
# Administration du serveur Keycloak, différente du rôle applicatif admin.
# Valeurs publiques de développement uniquement, jamais sur staging/prod.
KEYCLOAK_ADMIN_USER=bootstrap-local
KEYCLOAK_ADMIN_PASSWORD=bootstrap-local-only

# Moteur (apps/engine)
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8000
ENGINE_LOG_LEVEL=info
ENGINE_LOG_JSON=false
ENGINE_MAX_WORKERS=4

# Traitements asynchrones (US-009 A2), sur le poste comme l'API :
# pnpm nx run diagnostic-transport:serve   et   pnpm nx run engine:worker
AMQP_URL=amqp://trame:trame@127.0.0.1:5672
# Facultatif : chaque commande utilise le fichier versionné avec un chemin relatif à son cwd.
