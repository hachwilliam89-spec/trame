# Variables de développement local. Copier en `.env` à la racine : `cp .env.example .env`.
# Ne jamais commiter `.env`.
#
# Nx charge ce fichier pour toute commande `pnpm nx …` (serve, test, build…).
# Les applications ne lisent elles-mêmes aucun fichier `.env` : hors de Nx
# (`node dist/apps/api/main.js`, `uv run …`), exporter les variables, par exemple
# avec `set -a; . ./.env; set +a`. En staging et en prod, Docker Compose fournit
# l'environnement (US-005). Les tests n'en dépendent pas : chacun fixe ses valeurs.

# API (apps/api)
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://trame:trame@localhost:5432/trame

# Moteur (apps/engine)
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8000
ENGINE_LOG_LEVEL=info
ENGINE_LOG_JSON=false
ENGINE_MAX_WORKERS=4
