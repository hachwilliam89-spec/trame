// Schéma Prisma de l'API (ADR-0008, ADR-0022).
// Un schéma Postgres par bounded context, sans relation entre contextes : les références passent par identifiant.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["organization", "scheduling"]
}

// ─── Contexte organization (US-030) ─────────────────────────────────────────

/// Site d'une organisation : un entrepôt, avec son fuseau IANA.
model Site {
  id             String          @id @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  /// Unique dans l'organisation.
  code           String          @db.VarChar(20)
  name           String          @db.VarChar(100)
  timeZone       String          @map("time_zone") @db.VarChar(64)
  createdAt      DateTime        @map("created_at") @db.Timestamptz(3)
  shiftTemplates ShiftTemplate[]
  positions      Position[]

  @@unique([organizationId, code])
  /// Cible de la clé étrangère composite des créneaux types.
  @@unique([id, organizationId])
  @@map("sites")
  @@schema("organization")
}

/// Compétence réutilisable dans tous les sites d'une organisation.
model Skill {
  id             String          @id @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String          @db.VarChar(100)
  createdAt      DateTime        @map("created_at") @db.Timestamptz(3)
  positions      PositionSkill[]

  @@unique([id, organizationId])
  @@index([organizationId, id])
  @@map("skills")
  @@schema("organization")
}

/// Poste d'un site, avec ses compétences requises.
model Position {
  id             String          @id @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  siteId         String          @map("site_id") @db.Uuid
  name           String          @db.VarChar(100)
  createdAt      DateTime        @map("created_at") @db.Timestamptz(3)
  site           Site            @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  skills         PositionSkill[]

  @@unique([id, organizationId])
  @@index([organizationId, siteId, id])
  @@map("positions")
  @@schema("organization")
}

/// Les deux clés composites imposent la même organisation au poste et à la compétence.
model PositionSkill {
  organizationId String   @map("organization_id") @db.Uuid
  positionId     String   @map("position_id") @db.Uuid
  skillId        String   @map("skill_id") @db.Uuid
  position       Position @relation(fields: [positionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  skill          Skill    @relation(fields: [skillId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([positionId, skillId])
  @@index([skillId, organizationId])
  @@map("position_skills")
  @@schema("organization")
}

/// Créneau type d'un site. Les heures sont locales au site, en minutes depuis minuit (0 à 1439) :
/// une heure locale n'est pas un instant, elle ne prend son sens qu'avec une date et le fuseau du site.
model ShiftTemplate {
  id                   String   @id @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  siteId               String   @map("site_id") @db.Uuid
  label                String   @db.VarChar(50)
  startMinute          Int      @map("start_minute") @db.SmallInt
  endMinute            Int      @map("end_minute") @db.SmallInt
  /// Un créneau type a toujours une pause positionnée (US-030).
  breakStartMinute     Int      @map("break_start_minute") @db.SmallInt
  breakDurationMinutes Int      @map("break_duration_minutes") @db.SmallInt
  createdAt            DateTime @map("created_at") @db.Timestamptz(3)
  /// La clé étrangère porte aussi l'organisation : un créneau appartient toujours à celle de son site.
  site                 Site     @relation(fields: [siteId, organizationId], references: [id, organizationId])

  @@index([siteId, organizationId])
  @@map("shift_templates")
  @@schema("organization")
}

// ─── Diagnostic technique du contexte scheduling (US-009 A1) ────────────────

model DiagnosticRun {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  status         String   @db.VarChar(16)
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, id])
  @@map("diagnostic_runs")
  @@schema("scheduling")
}

/// Le relais et le marquage de publication arriveront avec A2.
model OutboxMessage {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  type           String   @db.VarChar(100)
  body           Json     @db.JsonB
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)

  @@index([organizationId, id])
  @@map("outbox_messages")
  @@schema("scheduling")
}
